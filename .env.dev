# connection_limit=20: support high-concurrency agent clusters (default is ~5-10)
# pool_timeout=30: give slow queries 30s before failing (default 10s)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/handy?connection_limit=20&pool_timeout=30
REDIS_URL=redis://localhost:6379
HANDY_MASTER_SECRET=your-super-secret-key-for-local-development
PORT=3005

# Metrics server configuration
METRICS_ENABLED=false
METRICS_PORT=9090

# Uncomment to enable centralized logging for AI debugging (creates .logs directory)
DANGEROUSLY_LOG_TO_SERVER_FOR_AI_AUTO_DEBUGGING=true

# --- Local S3/MinIO ---
# Defaults for local MinIO started via `yarn s3`
S3_HOST=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aha
S3_PUBLIC_URL=http://localhost:9000/aha

# --- Voice Feature ---
# 11Labs API for voice conversations (required for voice feature)
# Secret - congiured in .env, not checked in

NODE_ENV=development
